{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run verify:all)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run test:e2e)",
      "Bash(npx playwright test*)",
      "Bash(bash scripts/verify.sh*)",
      "Bash(pypogo/.venv/bin/python -m pytest*)",
      "Bash(pypogo/.venv/bin/python -m ruff check*)",
      "Bash(pypogo/.venv/bin/python -m mypy*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/stop-gate.sh",
            "timeout": 180,
            "statusMessage": "Running verification gate..."
          }
        ]
      }
    ]
  }
}
